---
// src/components/Footer.astro
const { settings, socials } = Astro.props;
const currentYear = new Date().getFullYear();

const schoolName = settings?.schoolName || 'SMA ABBS';
const schoolRegion = settings?.schoolRegion || 'Surakarta';
const shortDesc = settings?.shortDesc || 'Mewujudkan generasi ulul albab yang berakhlak mulia, berprestasi tinggi dalam sains, dan berwawasan global.';
const copyright = settings?.copyright || `© ${currentYear} ${schoolName} ${schoolRegion}. High Performance School.`;
const hasLinkColumns = (settings?.col1Links?.length > 0) || (settings?.col2Links?.length > 0);
---
<footer class="bg-[#020408] text-gray-400 pt-20 pb-10 border-t border-white/5 relative overflow-hidden font-['Montserrat']">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" 
         style="background-image: url('https://upload.wikimedia.org/wikipedia/commons/e/ec/World_map_blank_without_borders.svg'); background-size: cover; background-position: center;">
    </div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16 border-b border-white/10 pb-12">
            <div class="md:col-span-5">
                <h2 class="text-3xl font-bold text-white mb-4 tracking-tight">{schoolName} <span class="text-yellow-600">{schoolRegion}</span></h2>
                <p class="text-sm leading-relaxed text-gray-500 mb-6 max-w-sm">
                    {shortDesc}
                </p>

                {(settings?.address || settings?.phone || settings?.email) && (
                    <ul class="text-xs text-gray-500 space-y-2 mb-6">
                        {settings?.address && (
                            <li class="flex items-start gap-2"><i class="fa-solid fa-location-dot mt-0.5"></i><span>{settings.address}</span></li>
                        )}
                        {settings?.phone && (
                            <li class="flex items-center gap-2"><i class="fa-solid fa-phone"></i><span>{settings.phone}</span></li>
                        )}
                        {settings?.email && (
                            <li class="flex items-center gap-2"><i class="fa-solid fa-envelope"></i><span>{settings.email}</span></li>
                        )}
                    </ul>
                )}

                <div class="flex gap-4">
                    {socials?.socmedIg && (
                        <a href={socials.socmedIg} target="_blank" rel="noopener noreferrer" class="w-10 h-10 border border-gray-700 flex items-center justify-center hover:bg-yellow-600 hover:border-yellow-600 hover:text-white transition duration-300 rounded-sm"><i class="fa-brands fa-instagram"></i></a>
                    )}
                    {socials?.socmedYt && (
                        <a href={socials.socmedYt} target="_blank" rel="noopener noreferrer" class="w-10 h-10 border border-gray-700 flex items-center justify-center hover:bg-red-600 hover:border-red-600 hover:text-white transition duration-300 rounded-sm"><i class="fa-brands fa-youtube"></i></a>
                    )}
                    {socials?.socmedWa && (
                        <a href={socials.socmedWa} target="_blank" rel="noopener noreferrer" class="w-10 h-10 border border-gray-700 flex items-center justify-center hover:bg-green-600 hover:border-green-600 hover:text-white transition duration-300 rounded-sm"><i class="fa-brands fa-whatsapp"></i></a>
                    )}
                    {socials?.socmedTk && (
                        <a href={socials.socmedTk} target="_blank" rel="noopener noreferrer" class="w-10 h-10 border border-gray-700 flex items-center justify-center hover:bg-gray-100 hover:border-gray-100 hover:text-gray-900 transition duration-300 rounded-sm"><i class="fa-brands fa-tiktok"></i></a>
                    )}
                </div>
            </div>

            <div class="md:col-span-7 flex flex-col md:items-end justify-center">
                <h3 class="text-white text-lg font-light mb-2">Jangan Lewatkan Informasi PPDB</h3>
                <form class="flex w-full md:w-auto">
                    <input type="email" placeholder="Masukkan Email Anda" class="bg-white/5 border border-gray-700 text-white px-6 py-3 w-full md:w-80 focus:outline-none focus:border-yellow-600 transition text-sm rounded-l-sm placeholder-gray-600 rounded-none">
                    <button class="bg-yellow-600 text-black px-6 py-3 font-bold text-sm uppercase tracking-wider hover:bg-yellow-500 transition rounded-r-sm rounded-none">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>

        {hasLinkColumns && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mb-16 max-w-xl">
                {settings?.col1Links?.length > 0 && (
                    <div>
                        <h4 class="text-white text-xs font-bold uppercase tracking-widest mb-5">{settings.col1Title || 'Akses Cepat'}</h4>
                        <ul class="space-y-3">
                            {settings.col1Links.map((link) => (
                                <li><a href={link.url} class="text-sm hover:text-yellow-500 transition">{link.label}</a></li>
                            ))}
                        </ul>
                    </div>
                )}
                {settings?.col2Links?.length > 0 && (
                    <div>
                        <h4 class="text-white text-xs font-bold uppercase tracking-widest mb-5">{settings.col2Title || 'Akademik'}</h4>
                        <ul class="space-y-3">
                            {settings.col2Links.map((link) => (
                                <li><a href={link.url} class="text-sm hover:text-yellow-500 transition">{link.label}</a></li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>
        )}

        <div class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-white/5 text-xs text-gray-600">
            <p>{copyright}</p>
            <div class="flex gap-6 mt-4 md:mt-0">
                <a href="#" class="hover:text-white transition">Privacy Policy</a>
                <a href="#" class="hover:text-white transition">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>

---
// src/components/Navbar.astro
const { settings, socials } = Astro.props;

const menuLabel = settings?.menuLabel || 'MENU';
const ctaLabel = settings?.ctaLabel || 'DAFTAR';
const ctaLink = settings?.ctaLink || '/';
const journalLabel = settings?.journalLabel || 'JURNAL';
const menuItems = settings?.menuItems || [];
---
<nav class="absolute top-0 left-0 w-full z-50 flex justify-between items-start font-['Montserrat']">
    <div class="flex items-stretch">
        <button id="nav-menu-toggle" type="button"
            class="bg-white text-gray-900 px-6 py-4 flex items-center gap-2 hover:bg-gray-100 transition rounded-none cursor-pointer">
            <i class="fa-solid fa-bars text-xl"></i>
            <span class="font-bold tracking-widest text-sm">{menuLabel}</span>
        </button>

        <a href={ctaLink} class="bg-[#800000] text-white px-8 py-4 flex items-center font-bold tracking-widest text-sm hover:bg-[#600000] transition rounded-none">
            {ctaLabel}
        </a>
    </div>

    <div class="hidden md:flex items-center gap-6 px-8 py-4 text-white">
        {socials?.socmedWa && (
            <a href={socials.socmedWa} target="_blank" rel="noopener noreferrer" class="hover:text-yellow-500 transition"><i class="fa-brands fa-whatsapp text-xl"></i></a>
        )}
        {socials?.socmedIg && (
            <a href={socials.socmedIg} target="_blank" rel="noopener noreferrer" class="hover:text-yellow-500 transition"><i class="fa-brands fa-instagram text-xl"></i></a>
        )}
        {socials?.socmedYt && (
            <a href={socials.socmedYt} target="_blank" rel="noopener noreferrer" class="hover:text-yellow-500 transition"><i class="fa-brands fa-youtube text-xl"></i></a>
        )}

        <div class="h-4 w-px bg-white/50 mx-2"></div>

        <a href="/news" class="text-xs font-bold tracking-widest hover:text-yellow-500 transition uppercase">
            {journalLabel}
        </a>

        <a href="#" class="flex items-center gap-2 font-light text-sm hover:text-yellow-500 transition">
            <i class="fa-solid fa-magnifying-glass"></i>
        </a>
    </div>
</nav>

<!-- OVERLAY MENU FULL SCREEN (isi dari navbarSettings.menuItems, support submenu) -->
<div id="nav-menu-overlay" class="fixed inset-0 z-[9998] hidden bg-[#0b0f19] text-white overflow-y-auto">
    <div class="flex justify-end p-6">
        <button id="nav-menu-close" type="button" aria-label="Tutup menu"
            class="w-12 h-12 rounded-full border border-white/30 flex items-center justify-center hover:bg-white hover:text-gray-900 transition text-xl cursor-pointer">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="container mx-auto px-6 md:px-12 pb-20 max-w-4xl">
        {menuItems.length > 0 ? (
            <ul class="space-y-1">
                {menuItems.map((item) => (
                    <li class="border-b border-white/10 py-4">
                        {item.submenus && item.submenus.length > 0 ? (
                            <details>
                                <summary class="flex items-center justify-between cursor-pointer list-none">
                                    <span class="text-2xl md:text-4xl font-light uppercase tracking-wide hover:text-yellow-500 transition">{item.title}</span>
                                    <i class="fa-solid fa-chevron-down text-sm text-gray-400"></i>
                                </summary>
                                <ul class="mt-4 ml-4 md:ml-8 space-y-3">
                                    {item.submenus.map((sub) => (
                                        <li>
                                            <a href={sub.link} class="text-base md:text-lg text-gray-300 hover:text-yellow-500 transition">{sub.title}</a>
                                        </li>
                                    ))}
                                </ul>
                            </details>
                        ) : (
                            <a href={item.link} class="block text-2xl md:text-4xl font-light uppercase tracking-wide hover:text-yellow-500 transition">
                                {item.title}
                            </a>
                        )}
                    </li>
                ))}
            </ul>
        ) : (
            <p class="text-gray-400 italic">Menu belum diisi di Sanity Studio (Pengaturan Global → Navbar Menu).</p>
        )}
    </div>
</div>

<style>
    #nav-menu-overlay details > summary::-webkit-details-marker { display: none; }
    #nav-menu-overlay details[open] .fa-chevron-down { transform: rotate(180deg); }
    #nav-menu-overlay .fa-chevron-down { transition: transform 0.2s ease; }
</style>

<script>
    const toggleBtn = document.getElementById('nav-menu-toggle');
    const closeBtn = document.getElementById('nav-menu-close');
    const overlay = document.getElementById('nav-menu-overlay');

    toggleBtn?.addEventListener('click', () => {
        overlay?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    });

    closeBtn?.addEventListener('click', () => {
        overlay?.classList.add('hidden');
        document.body.style.overflow = '';
    });
</script>

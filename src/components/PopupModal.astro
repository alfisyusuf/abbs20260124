---
// src/components/PopupModal.astro
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";

const { popup } = Astro.props;
const builder = createImageUrlBuilder(sanityClient);

const now = new Date();
const withinDate =
  (!popup?.startDate || new Date(popup.startDate) <= now) &&
  (!popup?.endDate || new Date(popup.endDate) >= now);
const shouldShow = popup?.isActive && popup?.image && withinDate;

const imgUrl = shouldShow
  ? builder.image(popup.image).width(800).auto('format').url()
  : null;
---

{shouldShow && (
  <div id="popup-announcement" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 p-4">
    <div class="relative max-w-lg w-full">
      <button id="popup-close" aria-label="Tutup"
        class="absolute -top-4 -right-4 w-9 h-9 rounded-full bg-white text-gray-900 flex items-center justify-center shadow-lg text-xl leading-none cursor-pointer">
        &times;
      </button>
      {popup.link ? (
        <a href={popup.link}>
          <img src={imgUrl} alt="Pengumuman" class="w-full h-auto rounded-lg shadow-2xl" />
        </a>
      ) : (
        <img src={imgUrl} alt="Pengumuman" class="w-full h-auto rounded-lg shadow-2xl" />
      )}
    </div>
  </div>
)}

<script>
  const KEY = 'popup-shown';
  const overlay = document.getElementById('popup-announcement');

  if (overlay && !sessionStorage.getItem(KEY)) {
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    sessionStorage.setItem(KEY, '1');
  }

  document.getElementById('popup-close')?.addEventListener('click', () => {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }
  });
</script>

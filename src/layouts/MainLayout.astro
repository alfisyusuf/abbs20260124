---
// src/layouts/MainLayout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PopupModal from '../components/PopupModal.astro';
import '../styles/global.css'; // File CSS Tailwind
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";

const { title, description, image, ogType = 'website' } = Astro.props;

// Data global: pengaturan situs, navbar, footer, dan popup pengumuman — 1x fetch dipakai semua halaman
const globalData = await sanityClient.fetch(`{
  "settings": *[_type == "siteSettings"][0]{ logo, favicon, seoDescription, ogImageDefault, socmedIg, socmedYt, socmedWa, socmedTk },
  "popup": *[_type == "popupAnnouncement"][0],
  "navbar": *[_type == "navbarSettings"][0],
  "footer": *[_type == "footerSettings"][0]
}`);
const { settings, popup, navbar, footer } = globalData;

const builder = createImageUrlBuilder(sanityClient);

// --- FAVICON: prioritas favicon khusus, fallback ke logo, fallback ke file statis ---
const faviconSource = settings?.favicon || settings?.logo;
const faviconUrl = faviconSource
  ? builder.image(faviconSource).width(64).height(64).fit('crop').auto('format').url()
  : '/favicon.ico';

// --- OG IMAGE: prioritas gambar per-halaman, fallback ke gambar share default, fallback ke file statis ---
const ogSource = image || settings?.ogImageDefault;
const ogImageUrl = ogSource
  ? builder.image(ogSource).width(1200).height(630).fit('crop').auto('format').url()
  : new URL('/og-default.jpg', Astro.site).toString();

const pageTitle = title ? `${title} - SMA ABBS Surakarta` : 'SMA ABBS Surakarta';
const pageDescription = description || settings?.seoDescription || 'Mewujudkan generasi ulul albab yang berakhlak mulia, berprestasi tinggi dalam sains, dan berwawasan global.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" type="image/png" href={faviconUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (WhatsApp, Telegram, Facebook) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="SMA ABBS Surakarta" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
        /* CSS Tambahan untuk hal-hal yang ribet di Tailwind */
        body { font-family: 'Montserrat', sans-serif; }
        
        /* Custom Maroon - Biar konsisten dengan desain Bapak */
        .text-maroon { color: #800000; }
        .bg-maroon { background-color: #800000; }
        
        /* Animation Classes */
        @keyframes scroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .logo-scroll-wrapper {
            display: flex;
            width: max-content;
            animation: scroll 40s linear infinite;
        }
        .logo-scroll-wrapper:hover { animation-play-state: paused; }
        
        .play-btn:hover { transform: scale(1.1); }
        .glass-panel {
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(5px);
        }
    </style>
</head>
<body class="bg-white text-gray-800 m-0 p-0 overflow-x-hidden">

    <Navbar settings={navbar} socials={settings} />
    <PopupModal popup={popup} />

    <slot />

    <Footer settings={footer} socials={settings} />

</body>
</html>
